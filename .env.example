# Copy to .env.local (or set on the server) and fill in.

# Contact form email (https://resend.com). Without these the form shows an error that points to your email.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Parth Makwana <hello@parthdev.co.in>"
CONTACT_FROM_EMAIL=
# Where enquiries go. Defaults to the email in content/site.ts.
CONTACT_TO_EMAIL=

# Public links. The WhatsApp and "Book a call" links are hidden while these are empty.
# e.g. https://wa.me/91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_URL=
# e.g. https://cal.com/your-name/intro
NEXT_PUBLIC_BOOKING_URL=
